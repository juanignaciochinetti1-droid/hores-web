<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Producto "puente" para las solicitudes de pedido del sitio.

        El catálogo público (mi_sitio_web.producto) es un modelo propio,
        no los productos reales de Odoo (product.product) — decisión
        tomada para no migrar todo el catálogo/imágenes/variantes a los
        modelos nativos solo para poder registrar una solicitud. Como
        sale.order.line SÍ necesita un product_id real, se usa este único
        producto genérico como línea de cada presupuesto: el detalle real
        (qué molde, qué variante, qué cantidad, notas del cliente) queda
        en el texto de la línea (name), no en este producto.

        Ver controllers/main.py (ruta /mi-sitio/pedido) y
        DOCS/07-pedidos.md.
    -->
    <record id="product_pedido_generico" model="product.product">
        <field name="name">Solicitud de pedido — sitio web</field>
        <field name="type">service</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="list_price">0.0</field>
        <field name="invoice_policy">order</field>
    </record>
</odoo>
