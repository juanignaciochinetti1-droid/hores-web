<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categorías -->
    <record id="view_mi_sitio_web_categoria_list" model="ir.ui.view">
        <field name="name">mi_sitio_web.categoria.list</field>
        <field name="model">mi_sitio_web.categoria</field>
        <field name="arch" type="xml">
            <list string="Categorías" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
            </list>
        </field>
    </record>

    <record id="action_mi_sitio_web_categoria" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">mi_sitio_web.categoria</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Productos -->
    <record id="view_mi_sitio_web_producto_list" model="ir.ui.view">
        <field name="name">mi_sitio_web.producto.list</field>
        <field name="model">mi_sitio_web.producto</field>
        <field name="arch" type="xml">
            <list string="Productos del sitio">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="disponibilidad"/>
                <field name="is_custom"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="view_mi_sitio_web_producto_form" model="ir.ui.view">
        <field name="name">mi_sitio_web.producto.form</field>
        <field name="model">mi_sitio_web.producto</field>
        <field name="arch" type="xml">
            <form string="Producto del sitio">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="summary"/>
                            <field name="disponibilidad"/>
                            <field name="is_custom"/>
                            <field name="is_published"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <!-- Solo aplica si el producto NO tiene variantes (ver
                         pestaña Variantes) — con variantes, el producto de
                         venta/precio se carga por tamaño, no acá. -->
                    <group invisible="variante_ids">
                        <field name="sale_product_id" string="Producto de venta (eCommerce)"/>
                    </group>
                    <field name="description" placeholder="Descripción completa..."/>
                    <notebook>
                        <page string="Especificaciones técnicas">
                            <field name="spec_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Características destacadas">
                            <field name="feature_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Variantes">
                            <field name="variante_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="weight"/>
                                    <field name="dimensions"/>
                                    <field name="image" widget="image"/>
                                    <field name="sale_product_id" string="Producto de venta"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mi_sitio_web_producto" model="ir.actions.act_window">
        <field name="name">Productos del sitio</field>
        <field name="res_model">mi_sitio_web.producto</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mi_sitio_web_root" name="Mi Sitio Web" sequence="60"/>
    <menuitem id="menu_mi_sitio_web_producto" name="Productos"
              parent="menu_mi_sitio_web_root"
              action="action_mi_sitio_web_producto" sequence="10"/>
    <menuitem id="menu_mi_sitio_web_categoria" name="Categorías"
              parent="menu_mi_sitio_web_root"
              action="action_mi_sitio_web_categoria" sequence="20"/>
</odoo>
