<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Paleta de colores del sitio aplicada a las páginas nativas de
        eCommerce (/shop, /shop/cart, /shop/checkout, etc.) — esas páginas
        las arma website_sale con sus propias plantillas (header/nav
        default de Odoo, no nuestro site_header), así que no pasan por
        mi_sitio_web.head_assets. Para que combinen visualmente con el
        resto del sitio sin reescribir esas plantillas nativas (riesgo de
        romper el buscador/carrito propios de website_sale, que dependen
        de esa estructura), se sobreescribe acá el fondo, tipografías,
        botones y links vía CSS — inheredado de website.layout, así que
        aplica a TODAS las páginas (incluidas las nuestras, pero ahí no
        cambia nada visible: ya fijamos estos mismos colores a mano con
        estilos inline, que tienen más especificidad que estas reglas).

        Ver DOCS/07-pedidos.md — el header/nav en sí sigue siendo el
        default de Odoo, no el nuestro; esto es solo paleta de colores y
        tipografía, no una reconstrucción completa de esas pantallas.
    -->
    <template id="ecommerce_theme" inherit_id="website.layout">
        <xpath expr="//head/meta[last()]" position="after">
            <!-- Nuestras propias páginas ya cargan estas mismas familias
                 (y más) vía mi_sitio_web.head_assets, t-call'eado dentro de
                 #wrap: todas ellas ponen no_header=True para suprimir el
                 header genérico de Odoo (ver comentario de categoria_template
                 más abajo en catalogo_templates.xml). Repetir acá el mismo
                 <link> de Google Fonts en esas páginas duplicaba una
                 request bloqueante de render en el <head> de cada carga sin
                 aportar nada nuevo. Solo hace falta en /shop y el checkout
                 nativo de website_sale, que sí dependen de este template
                 (no_header queda False/sin definir ahí). -->
            <t t-if="not no_header">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&amp;family=Archivo:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
            </t>
            <style>
                /* Variables de Bootstrap 5: la mayoría de los componentes
                   nativos (botones, links, focus) las consumen en cascada.
                   OJO: el Bootstrap que compila esta versión de Odoo NO usa
                   el prefijo "bs-" en el nombre de las variables (--primary,
                   --body-bg, --link-color...), a pesar de que la
                   documentación pública de Bootstrap 5 sí lo usa. Se
                   confirmó abriendo el bundle compilado
                   (web.assets_frontend.min.css) y viendo el nombre real de
                   la variable que consume la regla de fondo del body. Se
                   dejan las dos versiones (con y sin prefijo) para no
                   depender de esto si Odoo cambia de convención en otro
                   bundle. */
                :root {
                    --primary: #c26a1e;
                    --body-bg: #f6f4ef;
                    --body-color: #241d17;
                    --body-font-family: 'Archivo', system-ui, sans-serif;
                    --link-color: #c26a1e;
                    --link-hover-color: #a85a19;
                    --border-color: #e8e3d9;
                    --bs-primary: #c26a1e;
                    --bs-primary-rgb: 194, 106, 30;
                    --bs-body-bg: #f6f4ef;
                    --bs-body-color: #241d17;
                    --bs-body-font-family: 'Archivo', system-ui, sans-serif;
                    --bs-link-color: #c26a1e;
                    --bs-link-color-rgb: 194, 106, 30;
                    --bs-link-hover-color: #a85a19;
                    --bs-border-color: #e8e3d9;

                    /* Recetas de hover/foco compartidas por TODO el sitio
                       (esta plantilla inyecta en website.layout, que
                       aplica a todas las páginas) -- antes cada archivo
                       (catalogo_templates.xml para las páginas propias,
                       este para el carrito/checkout nativo) tenía su
                       propia copia calcada de estos mismos valores;
                       ahora las dos las leen de acá, así que cambiar el
                       "look" del hover o el foco de todo el sitio es
                       editar estas líneas nada más, no buscar cada
                       copia. */
                    --hc-hover-lift: translateY(-2px);
                    --hc-hover-brightness: brightness(1.07);
                    --hc-hover-shadow: 0 8px 18px rgba(0,0,0,.14);
                    --hc-focus-outline: 2.5px solid #c26a1e;
                    --hc-focus-offset: 2px;
                }
                /* Botón "Contáctanos" del header genérico de Odoo y
                   cualquier otro elemento .btn-primary/.btn-outline-primary/
                   .bg-primary nativo por fuera de nuestras propias páginas
                   (portal "Mi cuenta", /web/login, 404 nativo, etc. --
                   páginas que sí pasan por website.layout, pero sin
                   contenedor .oe_website_sale) quedaban con el violeta por
                   defecto de Odoo (#714B67): --primary/--bs-primary de acá
                   arriba NO alcanza para recolorearlos, porque el CSS
                   compilado de Bootstrap 5.3 define ese color como una
                   variable LOCAL de cada regla (--btn-bg, --badge-bg...),
                   no algo que lea de --bs-primary en cascada -- confirmado
                   abriendo el bundle compilado (web.assets_frontend.min.css)
                   y viendo el valor real de esas variables. Mismo criterio
                   que el bloque de acá abajo para .oe_website_sale (esas
                   páginas SÍ necesitaban su propio refuerzo por la misma
                   razón), pero sin ese scope, para cubrir todo lo demás
                   (encontrado en revisión de código, 07/09/2026, a partir
                   de un screenshot de "Mi cuenta" con el botón todavía
                   violeta a pesar de este mismo archivo). */
                .btn-primary {
                    background-color: #c26a1e !important;
                    border-color: #c26a1e !important;
                }
                .btn-primary:hover, .btn-primary:focus {
                    background-color: #a85a19 !important;
                    border-color: #a85a19 !important;
                }
                .btn-outline-primary {
                    color: #c26a1e !important;
                    border-color: #c26a1e !important;
                }
                .btn-outline-primary:hover {
                    background-color: #c26a1e !important;
                    color: #fff !important;
                }
                .bg-primary {
                    background-color: #c26a1e !important;
                }
                .text-primary {
                    color: #c26a1e !important;
                }
                .dropdown-item.active, .dropdown-item:active {
                    background-color: #c26a1e !important;
                    color: #fff !important;
                }
                /* Portal nativo ("Mi cuenta", Direcciones, Seguridad, etc.,
                   todo bajo .o_portal_wrap) -- a pedido explícito
                   (07/09/2026, con screenshot: "se puede mejorar un poco
                   más"), después del arreglo de color de más arriba. Los
                   títulos pasan a la tipografía serif del resto del sitio
                   (igual que hc-product-name y compañía); las tarjetas de
                   accesos ("Sus órdenes", "Direcciones"...) dejan el gris
                   plano de Bootstrap (bg-100) por el mismo tratamiento que
                   ya usan las tarjetas de producto (hc-card: esquinas
                   redondeadas, sombra suave, se levantan un poco al pasar
                   el mouse -- reusa las mismas variables de hover que ya
                   comparte todo el sitio, ver --hc-hover-* más arriba); los
                   separadores (el de "Tu contacto", una regla horizontal)
                   pasan del gris de Bootstrap al mismo tono beige que separa
                   secciones en el resto del sitio. No se tocan los íconos
                   de cada tarjeta (SVG de color fijo, de Odoo) ni el avatar
                   del usuario (foto/inicial autogenerada por partner, no
                   tiene sentido forzarle un color de marca). */
                .o_portal_wrap h1, .o_portal_wrap h2, .o_portal_wrap h3,
                .o_portal_wrap h4, .o_portal_wrap h5, .o_portal_wrap h6 {
                    font-family: 'Source Serif 4', serif;
                    color: #241d17;
                }
                .o_portal_wrap hr {
                    border-color: #e8e3d9;
                    opacity: 1;
                }
                .o_portal_index_card > a {
                    background-color: #efe6d8 !important;
                    border-radius: 14px !important;
                    transition: transform .25s ease, box-shadow .25s ease;
                }
                .o_portal_index_card > a:hover {
                    transform: var(--hc-hover-lift);
                    box-shadow: var(--hc-hover-shadow);
                }
                /* El franjón blanco que quedaba a los costados en pantallas
                   anchas (contenedor de 1200px centrado, con blanco puro
                   alrededor) no era la etiqueta html (esa ya se pinta bien
                   con la variable de arriba) — es la etiqueta body, que
                   tiene su propio fondo opaco por encima y tapa lo que
                   pinte html detrás. El nombre de variable equivocado (ver
                   comentario de arriba) hacía que body terminara blanco en
                   vez de crema. Se pinta directo, con !important, para no
                   depender de que la variable se resuelva bien en cualquier
                   contexto — se aplica a toda página, no solo a las de
                   eCommerce, porque el bug es del body en general. */
                html, body {
                    background-color: #f6f4ef !important;
                }
                /* Refuerzo directo (algunos componentes de website_sale usan
                   colores compilados en el CSS, no solo las variables de
                   arriba) — limitado a las páginas de eCommerce por el
                   selector .oe_website_sale (el contenedor que arma
                   website_sale en /shop, /shop/cart, /shop/checkout), para
                   no pisar nuestras propias páginas por las dudas. La
                   etiqueta body de estas páginas no tiene clase propia,
                   por eso no se puede apuntar por "body.algo" acá. */
                .oe_website_sale {
                    background-color: #f6f4ef;
                }
                .oe_website_sale, .oe_website_sale .oe_currency_value {
                    color: #241d17;
                    font-family: 'Archivo', system-ui, sans-serif;
                }
                .oe_website_sale h1, .oe_website_sale h2, .oe_website_sale h3,
                .oe_website_sale h4, .oe_website_sale h5 {
                    font-family: 'Source Serif 4', serif;
                    color: #241d17;
                }
                .oe_website_sale .btn-primary,
                .oe_website_sale .o_wsale_product_btn_primary {
                    background-color: #c26a1e !important;
                    border-color: #c26a1e !important;
                }
                .oe_website_sale .btn-primary:hover,
                .oe_website_sale .o_wsale_product_btn_primary:hover {
                    background-color: #a85a19 !important;
                    border-color: #a85a19 !important;
                }
                .oe_website_sale .btn-outline-primary {
                    color: #c26a1e !important;
                    border-color: #c26a1e !important;
                }
                .oe_website_sale .btn-outline-primary:hover {
                    background-color: #c26a1e !important;
                    color: #fff !important;
                }
                .oe_website_sale a:not(.btn) {
                    color: #c26a1e;
                }
                .oe_website_sale .oe_currency_value,
                .oe_website_sale .o_wsale_products_item_price {
                    color: #c26a1e;
                }
                .oe_website_sale .card,
                .oe_website_sale .oe_product_cart {
                    border-color: #e8e3d9 !important;
                    border-radius: 12px !important;
                }
                .oe_website_sale .bg-light {
                    background-color: #efe6d8 !important;
                }
                /* A pedido explícito (26/08/2026): en el carrito/checkout no
                   se muestra nada de precios ni el código de descuento —
                   los productos migrados todavía no tienen precio real
                   cargado (ver DOCS/07-pedidos.md) y el pedido se coordina
                   por fuera (WhatsApp/mail), no por cobro online. Se
                   esconde con CSS (no se borra del template) para que el
                   día que haya precios reales sea un cambio de una línea,
                   no reescribir el override. */
                .oe_website_sale [name="website_sale_cart_line_price"],
                .oe_website_sale [name="website_sale_cart_summary_line_price"] {
                    display: none !important;
                }
                /* Filtro "Rango de precio" del costado de /shop (28/08/2026,
                   a pedido explícito, con screenshot): con todos los
                   productos en $0, el filtro queda min=max=$0,00 — Odoo
                   mismo ya lo nota y lo deja atenuado/sin clickear
                   (clases opacity-75 pe-none que trae de fábrica), pero
                   seguía ocupando lugar en la página, con pinta de roto.
                   Se esconde entero — el id se repite dos veces en el HTML
                   (barra lateral de escritorio + cajón de filtros de
                   mobile), así que el selector tapa las dos. */
                .oe_website_sale #o_wsale_price_range_option {
                    display: none !important;
                }
                /* .o_cart_total es la tarjeta de "Entrega / Subtotal /
                   Impuestos / Total" del resumen — el formulario de código
                   de descuento (.coupon_form) vive adentro tuyo, como una
                   fila más de la misma tabla, así que ocultando este
                   contenedor se van los dos juntos. */
                .oe_website_sale .o_cart_total {
                    display: none !important;
                }
                /* Mismo total, versión resumen para mobile (franja pegada
                   abajo en los pasos de dirección/pago). */
                .oe_website_sale #amount_total_summary {
                    display: none !important;
                }
                /* Botón "Volver al sitio" (ver footer_override_templates.xml
                   — se agrega ahí, junto al no_header de /shop, no acá). */
                .hc-back-to-site-btn:hover {
                    border-color: #c26a1e;
                    color: #c26a1e;
                }
                /* El catálogo (/shop) y el carrito/checkout usan .container
                   de Bootstrap. .oe_website_sale.container (las dos clases
                   juntas) apunta solo a esos contenedores nativos de
                   eCommerce, no a .container en general (nav, footer).
                   Mismo tope que el resto del sitio (ver sistema de
                   diseño) para que no quede más ancho que el resto de las
                   páginas — subirlo más (se probó 1600px) no achicaba en
                   los hechos el espacio vacío de los costados en un
                   monitor ancho, solo estiraba de más la tarjeta del
                   pedido (ver regla de #shop_cart más abajo). */
                .oe_website_sale.container {
                    max-width: 1200px !important;
                }
                /* Fila con la tarjeta del pedido (izquierda) y la de
                   totales (derecha), en el paso "Orden" del checkout: el
                   grid nativo de Bootstrap las deja con anchos que
                   dependen del ancho del contenedor (se estiran de más en
                   monitores anchos). Se las pasa a un ancho fijo cómodo de
                   leer, centradas como conjunto — así el espacio que sobra
                   en un monitor ancho queda repartido parejo alrededor del
                   conjunto en vez de estirar el contenido. :has() solo
                   engancha esta fila puntual (la que tiene la tarjeta del
                   pedido adentro), no las filas de Dirección/Pago. */
                .oe_website_sale .row:has(> .oe_cart) {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: center;
                    gap: 32px;
                }
                .oe_website_sale .oe_cart {
                    flex: 1 1 620px;
                    max-width: 680px;
                    width: auto !important;
                }
                .oe_website_sale .o_wsale_shorter_cart_summary {
                    flex: 1 1 340px;
                    max-width: 380px;
                    width: auto !important;
                    margin-left: 0 !important;
                }
                /* Panel de "Resumen de la orden": mismo look que las
                   tarjetas del resto del sitio (fondo blanco, borde,
                   sombra sutil — como .hc-card), en vez de flotar
                   directo sobre el fondo crema. */
                .oe_website_sale #shop_cart {
                    background-color: #ffffff;
                    border: 1px solid #e8e3d9;
                    border-radius: 14px;
                    padding: 26px 28px;
                    box-shadow: 0 2px 8px rgba(36,29,23,.05), 0 10px 26px rgba(36,29,23,.06);
                }
                .oe_website_sale .o_cart_product {
                    border-bottom: 1px solid #e8e3d9;
                    padding-bottom: 20px !important;
                    margin-bottom: 20px;
                }
                .oe_website_sale .o_cart_product:last-child {
                    border-bottom: none;
                    padding-bottom: 0 !important;
                    margin-bottom: 0;
                }
                .oe_website_sale .card,
                .oe_website_sale .bg-white.rounded {
                    box-shadow: 0 2px 8px rgba(36,29,23,.05), 0 10px 26px rgba(36,29,23,.06);
                }
                /* Panel de totales (Entrega/Subtotal/Total): mismo acento
                   naranja arriba que usa el footer del sitio. */
                .oe_website_sale .o_total_card {
                    border-top: 3px solid #c26a1e !important;
                }
                /* "Volver al carrito" / "Regresar a la dirección": el link
                   para corregir algo del paso anterior ya existe nativo en
                   cada paso del checkout, pero como texto gris chico
                   debajo del botón principal — fácil de pasar por alto
                   (28/08/2026, a pedido explícito: que se pueda volver a
                   corregir algo). Se le sube el peso visual a botón
                   secundario real, igual que "Volver al sitio". Se agarra
                   por el ícono (fa-angle-left es propio de este link, no
                   lo usa nada más en estas páginas) en vez de por una
                   clase o contenedor, porque el mismo link se repite sin
                   el mismo wrapper en la versión de mobile (cajón de
                   resumen). */
                .oe_website_sale a:has(> i.fa-angle-left) {
                    display: inline-flex !important;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    background: #ffffff;
                    border: 1px solid #e8e3d9;
                    border-radius: 9px;
                    padding: 10px 18px;
                    color: #5a4f44 !important;
                    font-weight: 600;
                    text-decoration: none !important;
                }
                .oe_website_sale a:has(> i.fa-angle-left):hover {
                    border-color: #c26a1e;
                    color: #c26a1e !important;
                }
                /* Pasos del checkout (Orden / Dirección / Pago): el paso
                   activo es un div name="step_name" con clase fw-bold, el
                   paso pendiente es un div name="step_name" con clase
                   text-muted (website.step_wizard, ambos vía t-if
                   is_current_step/not_completed_step). El paso YA
                   RECORRIDO es un caso aparte en esa misma plantilla
                   nativa -- se renderiza sin el atributo name="step_name"
                   de fábrica. La primera versión de esto apuntaba todo
                   por [name="step_name"] y el paso recorrido quedaba
                   afuera (se notaba recién al volver atrás desde
                   Dirección/Pago); un segundo intento cubrió ese caso
                   con un selector aparte por posición ("a > div"), pero
                   quedaba frágil a cualquier cambio futuro en cómo Odoo
                   arma ese HTML. Ahora se le agrega el mismo atributo
                   name="step_name" al paso recorrido por inheritance
                   (ver el template step_wizard_chip_hook más abajo,
                   mismo patrón que ya usa este archivo para
                   navigation_buttons/address_on_checkout) -- un solo
                   selector cubre los tres estados, y si una actualización
                   de Odoo cambia esa plantilla lo suficiente, el xpath
                   de acá abajo falla fuerte al actualizar el módulo, no
                   en silencio como pasaba con el selector por CSS. */
                .oe_website_sale .o_wizard [name="step_name"] {
                    padding: 7px 16px;
                    border-radius: 20px;
                    border: 1px solid #e8e3d9;
                    font-weight: 600;
                    transition: border-color .15s ease, color .15s ease, background-color .15s ease;
                }
                .oe_website_sale .o_wizard a {
                    color: #8a7a67;
                }
                .oe_website_sale .o_wizard a:hover {
                    color: #c26a1e;
                }
                .oe_website_sale .o_wizard a:hover [name="step_name"] {
                    border-color: #c26a1e;
                }
                .oe_website_sale .o_wizard .fw-bold {
                    color: #fff !important;
                    background: #c26a1e;
                    border-color: #c26a1e;
                }
                .oe_website_sale .o_wizard .text-muted {
                    border-style: dashed;
                }
                /* La flechita entre chips: el glifo de FontAwesome
                   (fa-angle-right) no está renderizando bien en este
                   entorno (aparece como "tofu box", el cuadrado de
                   reemplazo típico de un carácter que la fuente no
                   tiene) — probado también con un carácter de texto
                   plano ("›") y pasaba lo mismo (esa puntuación en
                   particular tampoco está en todas las fuentes). Se
                   dibuja la flechita en CSS puro (dos bordes rotados,
                   sin texto ni glifo de ningún tipo) para que no dependa
                   de ninguna fuente y ande seguro en cualquier entorno. */
                .oe_website_sale .o_wizard .fa-angle-right {
                    font-size: 0 !important;
                    display: inline-block !important;
                    width: 6px !important;
                    height: 6px !important;
                    margin: 0 6px !important;
                    vertical-align: middle;
                    /* !important en los 4 lados (no solo en las otras
                       propiedades de acá arriba): esta flechita SIEMPRE
                       lleva la clase text-muted de Bootstrap (es el
                       separador entre chips, ver el comentario de arriba),
                       y .text-muted más arriba en este mismo archivo le
                       pone border-style:dashed a los 4 lados con la misma
                       especificidad exacta que este selector -- sin
                       !important, cuál de las dos gana depende únicamente
                       del orden en el archivo, no de nada más robusto
                       (encontrado en revisión de código, 09/09/2026). */
                    border-right: 2px solid #8a7a67 !important;
                    border-top: 2px solid #8a7a67 !important;
                    border-bottom: none !important;
                    border-left: none !important;
                    transform: rotate(45deg);
                    opacity: .6;
                }
                /* Selector de cantidad (+/-) e input de código de descuento */
                .oe_website_sale .input-group .btn {
                    border-color: #d9ccb9 !important;
                    color: #5a4f44 !important;
                }
                .oe_website_sale .input-group .btn:hover {
                    background-color: #f6f4ef !important;
                    color: #c26a1e !important;
                }
                .oe_website_sale .form-control,
                .oe_website_sale .input-group input {
                    border-color: #d9ccb9 !important;
                }
                .oe_website_sale .form-control:focus {
                    border-color: #c26a1e !important;
                    box-shadow: 0 0 0 .2rem rgba(194,106,30,.15) !important;
                }
                /* Ícono del carrito vacío: es un SVG nativo de Odoo que
                   pinta el carrito con fill="currentColor" y un par de
                   detalles con var(--o-color-1)/var(--o-color-3) (slots de
                   color del theme builder) — quedaba en el gris genérico
                   por defecto (#D9D9D9/#000) en vez de la paleta del
                   sitio. Definiendo esas mismas variables acá arriba (se
                   heredan al SVG) y el color de texto del contenedor
                   (para el currentColor) se recolorea sin tocar el SVG.
                   OJO: --o-color-1/3 son los slots de color GENÉRICOS del
                   theme builder de Odoo — cualquier otro snippet nativo
                   (badges, ribbons, otro SVG con tema) que ande adentro de
                   .oe_website_sale también los lee. Por eso van acotados a
                   .js_cart_lines (el contenedor puntual de este ícono), no
                   a .oe_website_sale entero. */
                .oe_website_sale .js_cart_lines {
                    --o-color-1: #f0dcc0;
                    --o-color-3: #c26a1e;
                }
                .oe_website_sale .js_cart_lines svg {
                    color: #b0a390;
                }
                /* Paridad de hover/foco con el resto del sitio: estas
                   pantallas nativas de website_sale no están dentro de
                   .oe_structure (ver comentario del template más arriba),
                   así que no heredaban ni el lift+sombra al hover de los
                   botones ni el foco visible por teclado que sí tiene
                   todo lo demás — quedaban con el hover plano de
                   Bootstrap y sin foco visible al navegar con Tab. */
                .oe_website_sale a, .oe_website_sale button {
                    transition: background-color .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;
                }
                /* :not(.input-group .btn) -- el selector de cantidad (+/-)
                   y el botón "Aplicar" del código de descuento viven
                   pegados a un input dentro de un .input-group; levantarlos
                   2px al hover los despega del input vecino y rompe la
                   píldora (visto en pantalla: el "-" queda flotando por
                   encima del número). Esos ya tienen su propio hover más
                   sobrio (fondo/color, ver más abajo) — no necesitan el
                   lift+sombra del resto de los botones. */
                .oe_website_sale .btn:not(.input-group .btn):hover {
                    transform: var(--hc-hover-lift);
                    filter: var(--hc-hover-brightness);
                    box-shadow: var(--hc-hover-shadow);
                }
                .oe_website_sale a:focus-visible,
                .oe_website_sale button:focus-visible,
                .oe_website_sale input:focus-visible,
                .oe_website_sale textarea:focus-visible {
                    outline: var(--hc-focus-outline);
                    outline-offset: var(--hc-focus-offset);
                }
            </style>
            <!-- Botón "Tienda" del carrito vacío: nativo de website_sale,
                 apunta siempre a /shop (que ya redirige a la sección de
                 productos de la página principal) sin importar de dónde venía el
                 visitante, a pedido explícito (04/09/2026, con
                 screenshot): si estaba viendo la ficha de un producto
                 puntual, "Tienda" debería devolverlo ahí, no mandarlo al
                 catálogo entero de nuevo.

                 Segunda vuelta (revisión de código, mismo día): la
                 primera versión de esto reescribía el href al cargar la
                 página, con dos problemas reales: (1) el selector
                 ".js_cart_lines a" no es exclusivo del botón: Odoo
                 reusa esa misma clase para el contenedor de las líneas
                 del carrito CUANDO SÍ hay productos (#cart_products),
                 así que con el carrito no vacío el script terminaba
                 pisando el link de un producto real, no el botón
                 "Tienda"; (2) Odoo reemplaza ese bloque entero por AJAX
                 cuando el carrito cambia sin recargar la página (sacar
                 el último producto, por ejemplo), y el evento
                 DOMContentLoaded no vuelve a dispararse, así que el
                 arreglo dejaba de funcionar en ese caso.

                 Se resuelve con delegación de eventos en vez de tocar
                 el href de antemano: un solo listener en document que
                 intercepta el click bien acotado por el href real
                 ("/shop", el que trae de fábrica el botón "Tienda";
                 ningún link de producto usa ese href literal) y decide
                 el destino recién en ese momento, sin importar cuándo
                 se cargó o se reemplazó el bloque por AJAX. document.
                 referrer también se valida contra el propio origen del
                 sitio antes de usarlo como destino (un sitio externo
                 podría, en teoría, controlar ese valor): se compara el
                 pathname ya parseado con new URL(), no el string entero
                 del referrer, para que un query string o hash que
                 casualmente contenga "/producto/123" (ej. viniendo de
                 ?next=/producto/5) no cuente como si el visitante hubiera
                 estado viendo esa ficha de verdad (encontrado en revisión
                 de código, 09/09/2026: el link "volver" de más abajo ya
                 lo hacía bien, este quedó con la versión vieja). -->
            <script>
                document.addEventListener('click', function (ev) {
                    var btn = ev.target.closest('.js_cart_lines a[href="/shop"]');
                    if (!btn) return;
                    ev.preventDefault();
                    var ref = document.referrer || '';
                    var vieneDeUnProducto = false;
                    if (ref.indexOf(window.location.origin) === 0) {
                        try {
                            vieneDeUnProducto = /^\/producto\/\d+$/.test(new URL(ref).pathname);
                        } catch (err) {
                            vieneDeUnProducto = false;
                        }
                    }
                    window.location.href = vieneDeUnProducto ? ref : '/mi-sitio#productos';
                });
            </script>
            <!-- Links "volver" marcados con esta clase (categoria_template y
                 producto_detalle_template en catalogo_templates.xml, y acá
                 mismo el "Realizar otro pedido" del carrito, más abajo): el
                 href fijo que traen es solo el destino por defecto para
                 cuando no hay de dónde volver (visita directa, link externo,
                 buscador), a pedido explícito (07/09/2026, con
                 screenshot): si el visitante ya venía navegando por acá
                 adentro (por ejemplo, entró a esta categoría desde un
                 producto puntual, o al carrito desde la ficha de un
                 producto) y toca "volver", tiene que devolverlo a la página
                 real de la que vino, no siempre al mismo destino fijo,
                 mismo criterio que el botón "Tienda" de arriba. Vive acá
                 (no en head_assets, que solo t-callean nuestras propias
                 páginas) porque tiene que alcanzar también al
                 carrito/checkout nativo de website_sale: este template sí
                 llega a todas las páginas por igual (ver el comentario
                 largo al principio del archivo).

                 Bug real (08/09/2026, reportado por el usuario): cambiar de
                 idioma con el selector del header ES una navegación real
                 del navegador (un link normal a la misma página con otro
                 prefijo de idioma, de /producto/7 a /en/producto/7): si el
                 visitante cambiaba de idioma estando en la ficha de un
                 producto y ahí nomás tocaba "volver", history.back()
                 deshacía ESE cambio de idioma en vez de llevarlo a la
                 categoría/portada: volvía al idioma viejo, no al que
                 estaba usando. Se detecta comparando el referrer con la
                 página actual sacándoles el prefijo de idioma a los dos
                 (Odoo sirve el idioma por defecto sin prefijo y el resto
                 con su propio código de URL, ver res.lang.url_code): si
                 dan la misma página, el referrer no es una página anterior
                 de verdad, es solo el cambio de idioma, así que se deja
                 el href fijo de siempre (que Odoo ya sirve en el idioma
                 correcto solo con renderizar la página).

                 OJO (encontrado en revisión de código, 09/09/2026):
                 history.back() no sirve de nada si esta pestaña se abrió
                 recién (long-press/"abrir en pestaña nueva" en mobile, o
                 middle-click): el referrer queda seteado igual que en
                 una navegación normal, pero el historial de ESA pestaña
                 tiene una sola entrada, así que "volver" no tiene a dónde
                 ir y el link queda muerto (ni pasa a la página anterior
                 ni cae al href de siempre, porque ya se hizo
                 preventDefault). Se chequea history.length antes de
                 comprometerse a este camino. -->
            <script>
                document.addEventListener('click', function (ev) {
                    var link = ev.target.closest('.hc-back-link');
                    if (!link) return;
                    var hayHistorial = history.length > 1;
                    if (!hayHistorial) return;
                    var ref = document.referrer || '';
                    if (ref.indexOf(window.location.origin) !== 0) return;
                    var sinIdioma = function (pathname) {
                        return pathname.replace(/^\/(en|fr|de|it|pt|zh_CN)(\/|$)/, '/');
                    };
                    var refPath;
                    try {
                        refPath = new URL(ref).pathname;
                    } catch (err) {
                        return;
                    }
                    if (sinIdioma(refPath) === sinIdioma(window.location.pathname)) {
                        return;
                    }
                    ev.preventDefault();
                    history.back();
                });
            </script>
        </xpath>
    </template>

    <!-- website.step_wizard (Orden / Dirección / Pago, arriba del
         carrito/checkout): el paso YA RECORRIDO se renderiza sin el
         atributo name="step_name" que sí tienen el paso activo y el
         pendiente. Se lo agrega acá para que la CSS de arriba pueda
         apuntar a los tres estados con un solo selector, en vez de
         adivinar la posición del div en el HTML (ver el comentario
         largo junto a esa CSS). Si una actualización de Odoo cambia
         esta estructura lo suficiente como para que el xpath no
         encuentre el div, el módulo falla al actualizar: señal clara
         de que hay que revisar esto, en vez de un chip que
         silenciosamente deja de verse bien. -->
    <template id="step_wizard_chip_hook" inherit_id="website.step_wizard">
        <xpath expr="//a[@t-else='']/div[hasclass('d-flex', 'align-items-center')]" position="attributes">
            <attribute name="name">step_name</attribute>
        </xpath>
    </template>

    <!-- Calle/depto/ciudad/CP/país sacados del formulario de dirección
         del checkout (28/08/2026, a pedido explícito — "borralos
         directamente, no los ocultes"). No alcanza con ocultarlos con
         CSS: el servidor los exige por default
         (portal.CustomerPortal._get_mandatory_address_fields, ver
         controllers/main.py, WebsiteSaleHores._get_mandatory_address_fields
         — ahí se saca esa validación). La dirección de entrega se
         coordina a mano (WhatsApp/mail) después del pedido, no en el
         checkout.

         portal.address_form_fields es compartida con /my/address (el
         portal de cuenta de cliente) — hoy no se usa en este proyecto
         (checkout siempre como invitado, sin login, ver DOCS/07-pedidos.md),
         así que sacar los campos acá no rompe nada activo. Si algún día
         se activa el portal de cliente, esto también le va a sacar la
         dirección a esa pantalla — revisar en ese momento. -->
    <template id="direccion_checkout_sin_domicilio" inherit_id="portal.address_form_fields">
        <xpath expr="//div[@id='div_street']" position="replace"/>
        <xpath expr="//div[@id='div_street2']" position="replace"/>
        <xpath expr="//t[@t-if='zip_before_city']//div[@id='div_zip']" position="replace"/>
        <xpath expr="//div[@id='div_city']" position="replace"/>
        <xpath expr="//t[@t-if='not zip_before_city']//div[@id='div_zip']" position="replace"/>
        <!-- OJO con country_id: a diferencia de calle/ciudad/CP de arriba,
             este campo hay que dejarlo en el DOM aunque sea vacío y oculto
             (02/09/2026, bug real encontrado con el checkout roto en el
             navegador). portal/static/src/interactions/address.js
             (CustomerAddress._onChangeCountry, que corre solo con cargar
             la página, en willStart) hace
             `this.addressForm.country_id.value` sin chequear que el campo
             exista: si no hay NINGÚN elemento country_id en el form
             (que es lo que hacía este xpath con position="replace" vacío,
             igual que con calle/ciudad/CP), esa línea tira
             "Cannot read properties of undefined (reading 'value')" y
             frena TODA la inicialización de esa interacción, incluido el
             wiring del botón "Confirmar" (es un <a>, no un <button
             type=submit>, así que sin JS no manda nada al hacer click —
             por eso no aparecía ningún request en el server). Con el
             campo presente pero vacío, `parseInt('')` da NaN, entra en el
             `if (!countryId) return;` de esa función y corta ahí mismo,
             sin llegar a tocar state_id/zip/city (que si están sacados
             del form, como abajo) ni a pedir nada al servidor. Server-side
             ya acepta country_id vacío sin problema
             (_get_mandatory_address_fields en controllers/main.py
             devuelve un set() vacío, nada es obligatorio). -->
        <xpath expr="//div[@id='div_country']" position="replace">
            <input type="hidden" name="country_id" value=""/>
        </xpath>
        <xpath expr="//div[@id='div_state']" position="replace"/>
        <!-- "Responsabilidad de ARCA" (28/08/2026, a pedido explícito, con
             screenshot) — el div no tiene id propio (lo inserta
             l10n_ar/views/portal_address_templates.xml con position="before"
             sobre #div_vat, sin id), así que se agarra por el <label> que
             tiene adentro, que sí es estable.

             OJO, a diferencia de calle/ciudad/país de arriba: acá NO
             alcanza con sacar el campo y aflojar la validación nomás —
             se probó así primero y rompió la creación del cliente con un
             error de Postgres (columna partner_id de sale_order en NULL).
             La causa es un bug real en l10n_ar
             (l10n_ar/controllers/portal.py, L10nARPortalAccount.
             _validate_address_values): cuando el campo llega vacío,
             ese código hace
             `request.env['l10n_ar.afip.responsibility.type'].browse(None)`
             en vez de manejar el caso "no vino nada", y esa llamada
             revienta la transacción a medio camino. En vez de pelear
             contra ese bug, se reemplaza el campo visible por un
             <input type="hidden"> con "Consumidor Final" (código AFIP
             '5', el valor genérico para un cliente sin categoría fiscal
             declarada) ya cargado — así ese código de Odoo recibe
             siempre un valor real y nunca llega a ese camino roto. El
             cliente no ve ni elige nada. -->
        <xpath expr="//div[label[@for='l10n_ar_afip_responsibility_type_id']]" position="replace">
            <input type="hidden" name="l10n_ar_afip_responsibility_type_id"
                   t-att-value="request.env['l10n_ar.afip.responsibility.type'].sudo().search([('code', '=', '5')], limit=1).id"/>
        </xpath>
    </template>

    <!-- "Continue shopping" (botón de volver del carrito, cuando todavía no
         hay ningún paso anterior del checkout) — pasa a "Realizar otro
         pedido" (31/08/2026, a pedido explícito, con screenshot). Es texto
         fijo en website_sale.navigation_buttons, no un campo de
         website.checkout.step (esos son "Pago"→"Pedido" y el resto de los
         breadcrumbs, ver más arriba). El link sigue yendo a /shop (que ya
         redirige a la sección de productos de la página principal) como
         destino por defecto, pero se le suma la clase hc-back-link
         (07/09/2026, mismo pedido que categoria_template/
         producto_detalle_template): si el visitante llegó al carrito desde
         la ficha de un producto puntual, este link lo devuelve ahí en vez
         de mandarlo siempre al mismo lado; el listener que hace esto
         vive en el script de más arriba en este archivo, no acá.

         OJO: el template tiene DOS <t t-else="">, uno para el botón
         principal de "siguiente paso" (icono fa-angle-right, href dinámico)
         y otro para este link de volver (icono fa-angle-left, href fijo
         '/shop') — hay que agarrar este por el href literal, agarrar el
         primer t-else a secas rompe el botón principal de avanzar. -->
    <template id="volver_al_carrito_texto" inherit_id="website_sale.navigation_buttons">
        <xpath expr="//a[@t-att-href=&quot;'/shop'&quot;]" position="replace">
            <a t-att-href="'/shop'" class="mt-2 mt-lg-0 text-center hc-back-link">
                <i class="fa fa-angle-left me-2 fw-light"/>
                Realizar otro pedido
            </a>
        </xpath>
    </template>

    <!-- Tarjeta "Entrega y facturación" del checkout (31/08/2026, a pedido
         explícito, con 3 screenshots): antes mostraba Empresa y Nombre
         pegados en una sola línea sin salto, ej. "ancor, juan chinetti"
         — el widget nativo `contact` (fields=['name','address']) arma esa
         línea combinando lo que haya de calle/ciudad/país con el nombre,
         y como esos campos ya no existen en este checkout (ver la
         plantilla de arriba, direccion_checkout_sin_domicilio), lo único
         que queda es esa combinación cruda. Se reemplaza por dos líneas
         propias: Empresa (si el cliente la cargó — el campo es opcional)
         en negrita arriba, Nombre abajo. No se toca la rama de
         "pickup_location_data" (retiro en punto físico): no se usa en
         este proyecto, no hay motivo para tocarla. -->
    <template id="tarjeta_direccion_checkout" inherit_id="website_sale.address_on_checkout">
        <xpath expr="//t[@t-out='order.partner_shipping_id']" position="replace">
            <div>
                <div t-if="order.partner_shipping_id.commercial_company_name"
                     class="fw-bold" t-out="order.partner_shipping_id.commercial_company_name"/>
                <div t-out="order.partner_shipping_id.name"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-out='order.partner_invoice_id']" position="replace">
            <div>
                <div t-if="order.partner_invoice_id.commercial_company_name"
                     class="fw-bold" t-out="order.partner_invoice_id.commercial_company_name"/>
                <div t-out="order.partner_invoice_id.name"/>
            </div>
        </xpath>
    </template>

    <!-- Mismo arreglo que la plantilla de arriba, pero para la tarjeta con
         lápiz de "Dirección de entrega" del primer paso del checkout
         (/shop/checkout) — es una plantilla nativa DISTINTA
         (website_sale.address_card, clon propio de portal.address_card
         "para que los cambios del checkout no afecten al portal", según
         su propio comentario en el core) con el mismo widget `contact` y
         el mismo problema de texto crudo. `website_sale.address_card` es
         el punto de extensión correcto acá, no `portal.address_card`
         directo — ese sí lo comparte con /my/address (ver el comentario
         de direccion_checkout_sin_domicilio, más arriba en este archivo). -->
    <template id="tarjeta_direccion_lista_checkout" inherit_id="website_sale.address_card">
        <xpath expr="//t[@t-out='contact']" position="replace">
            <div>
                <div t-if="contact.commercial_company_name"
                     class="fw-bold" t-out="contact.commercial_company_name"/>
                <div t-out="contact.name"/>
            </div>
        </xpath>
    </template>
</odoo>
