<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Ojo con esto si se vuelve a tocar: Odoo tiene DOS plantillas de 404
        distintas según quién mira la página.
          - website.page_404  -> solo se usa si el visitante está logueado
            como diseñador del sitio (website.group_website_designer).
          - http_routing.404  -> lo que ve TODO EL MUNDO (visitante público,
            que es el 99.9% de los casos reales de un 404).
        La primera vez se sobreescribió website.page_404 por error y no
        cambiaba nada para un visitante normal — hay que apuntar acá, a
        http_routing.404, que es la que de verdad se renderiza para
        cualquiera que no esté logueado en el backend.
    -->
    <template id="http_routing_404" inherit_id="http_routing.404">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="replace">
            <t t-call="mi_sitio_web.pagina_no_encontrada"/>
        </xpath>
    </template>

    <template id="pagina_no_encontrada" name="Mi Sitio - Página no encontrada">
        <t t-call="website.layout">
            <t t-set="title">Página no encontrada — HORES Cartotécnica</t>
            <div id="wrap" class="oe_structure oe_empty">
                <t t-call="mi_sitio_web.head_assets"/>
                <div style="max-width:100%; overflow-x:hidden; background:#f6f4ef;">
                    <t t-call="mi_sitio_web.site_header"/>

                    <section style="max-width:640px; margin:0 auto; padding:110px 28px; text-align:center;">
                        <div style="font-family:'Source Serif 4',serif; font-weight:700; font-size:80px; line-height:1; color:#c26a1e; margin-bottom:8px;">404</div>
                        <h1 style="font-family:'Source Serif 4',serif; font-weight:700; font-size:28px; margin:0 0 12px; color:#241d17;">No encontramos esta página</h1>
                        <p style="font-size:16px; line-height:1.6; color:#5a4f44; margin:0 0 30px;">El link puede estar roto o la página se movió. Volvé al inicio o mirá el catálogo completo de moldes.</p>
                        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
                            <a href="/mi-sitio" style="background:#c26a1e; color:#fff; padding:13px 26px; border-radius:9px; font-weight:600; font-size:15px;">Volver al inicio</a>
                            <a href="/compras" style="background:#ffffff; border:1px solid #d9ccb9; color:#241d17; padding:13px 26px; border-radius:9px; font-weight:600; font-size:15px;">Ver catálogo</a>
                        </div>
                    </section>

                </div>
            </div>
        </t>
    </template>
</odoo>
